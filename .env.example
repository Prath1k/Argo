# =====================================================================
# ARGO AgriVision - Environment Variables Template
# =====================================================================
# Copy this file to .env and fill in your Supabase project credentials.
# In Supabase: Project Settings -> API -> Project URL & Project API Keys (anon / public)

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
VITE_BACKEND_API_URL=http://localhost:5050
